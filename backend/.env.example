# JokeVault Fastify Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DEV=1
LOG_LEVEL=info

# Database (MongoDB Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jokevault?retryWrites=true&w=majority

# Redis (Optional: if omitted, JokeVault uses safe in-memory fallback cache)
REDIS=redis://127.0.0.1:6379

# JWT Authentication Secrets
SECRET_ACC=your_super_secret_jwt_access_key_here_change_in_production
SECRET_REF=your_super_secret_jwt_refresh_key_here_change_in_production
COOKIE_SECRET=your_super_secret_cookie_signing_key_here
KEY=vault_admin_secret_key

# Cookie Environment (set to true in production with HTTPS)
PRODUCTION=false